# Copy this file to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# JSearch (RapidAPI) — free tier, no card. Get a key:
# 1) sign up at rapidapi.com
# 2) subscribe to the JSearch API (Basic / free plan)
# 3) copy your X-RapidAPI-Key here
RAPIDAPI_KEY=your-rapidapi-key

# Email digest (optional). For Gmail, create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_TO=you@gmail.com
